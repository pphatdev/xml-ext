{
  "name": "xml-ext",
  "version": "1.0.0",
  "exports": "./src/app.js",
  "tasks": {
    "test": "deno test",
    "dev": "deno run --allow-net --allow-read dev-server.js",
    "fmt": "deno fmt src/ tests/",
    "fmt:check": "deno fmt --check src/ tests/",
    "lint": "deno lint src/ tests/",
    "check": "deno lint src/ tests/ && deno test"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-window", "no-window-prefix"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  }
}
